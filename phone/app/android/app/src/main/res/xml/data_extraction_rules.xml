<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Orbit's leaves the phone, by cloud backup or by a transfer to a new phone: the pairing token is
     encrypted under a key in this phone's Android Keystore, which neither could carry. A new phone pairs again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
