{
  "rules": {
    "orbit": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "link": {
      "$code": {
        ".validate": "$code.length === 8",
        ".read": "auth != null && data.child('tv').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('tv').val() === auth.uid) || (data.child('tv').val() === auth.uid && !newData.exists()))",
        "token": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && data.parent().exists() && !data.exists() && newData.isString() && newData.val().length < 4096"
        }
      }
    }
  }
}
