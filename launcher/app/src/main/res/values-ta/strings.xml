    <string name="card_prompt_title">%1$s-இடமிருந்து புதிய கார்டு</string>
    <string name="card_prompt_body">%1$s உங்கள் முகப்புத் திரையில் ஒரு கார்டைக் காட்டலாம். அதை மறைத்தே வைத்தால், ஆப்பின் வழக்கமான டைல் அப்படியே இருக்கும்.</string>
    <string name="card_prompt_names">கார்டின் பெயர் ‘%1$s’. ஆப்பின் பெயர் ‘%2$s’.</string>
    <string name="card_prompt_resigned">%1$s வேறொரு கையொப்ப விசையுடன் புதுப்பிக்கப்பட்டுள்ளது, எனவே உங்கள் முந்தைய பதில் இனி பொருந்தாது. அதன் கார்டுக்கு மீண்டும் முடிவு செய்யுங்கள்.</string>
    <string name="card_prompt_relabelled">நீங்கள் முடிவு செய்த பிறகு %1$s அதன் கார்டின் பெயரை மாற்றியுள்ளது. அதற்கு மீண்டும் முடிவு செய்யுங்கள்.</string>
    <string name="card_prompt_hint">இதைப் பின்னர் மாற்றலாம்: அமைப்புகளில் OK-ஐ அழுத்திப் பிடித்து, மாட்யூல் கார்டுகள் என்பதைத் தேர்ந்தெடுங்கள்.</string>
