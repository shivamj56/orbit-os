tools/venv
tools/adbkey/
__pycache__/
launcher/.gradle/
launcher/build/
launcher/app/build/
launcher/local.properties
# your own TV's dumps (serial, android_id, device names) stay local
backup/
# session screenshots and working notes (may show the Wi-Fi name or account avatar) stay local
shots/
work/
# Perfetto traces from tools/trace.py: large, and they hold the TV's process list
traces/
# Results from tools/bench.py: result.json carries the address the run was given and the TV's fingerprint.
bench-results/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
launcher/hs_err_pid*.log
launcher/replay_pid*.log
# Live TV (launcher/livetv): its build output.
launcher/livetv/build/
# Orbit (phone/): installed packages and the generated one-file UI (phone/ui/dist, copied into the app by
# phone/app/tool/sync_ui.sh), rebuilt from source every time.
phone/ui/node_modules/
phone/ui/dist/
phone/app/assets/ui/
# The Firebase project's API key and ids stay on this Mac, never in git (phone/SPEC.md "From anywhere").
phone/firebase/config.json
phone/app/android/app/google-services.json

# Orbit Setup bundle (both launcher APKs + the two TV scripts), copied in by phone/app/tool/sync_setup.sh
# before a build. The APKs must never be committed.
phone/app/assets/setup/
